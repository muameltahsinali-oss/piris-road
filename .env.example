# Where freight quote requests are emailed.
# The original WordPress site sent these to the theme author's Gmail address by
# mistake — see RECOVERY_REPORT.md §8. Set a real Piris Road inbox here.
QUOTE_RECIPIENT=info@pirisroad.iq
NEWSLETTER_RECIPIENT=info@pirisroad.iq
CONTACT_RECIPIENT=info@pirisroad.iq

# Transactional email (Resend). Without a key the forms still validate and
# accept submissions, logging them server-side instead of sending.
RESEND_API_KEY=
QUOTE_FROM="Piris Road <noreply@pirisroad.iq>"

# Extra hostnames the form endpoints accept in the Origin header (comma
# separated), e.g. a staging domain. The request's own host and pirisroad.iq
# are always allowed.
ALLOWED_ORIGINS=

# Admin dashboard (/admin). Without ADMIN_PASSWORD the dashboard stays locked.
# ADMIN_SECRET (optional) signs login sessions; changing it signs everyone out.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Where form submissions are stored for the dashboard (JSON files).
# Defaults to ./.data. On Railway, attach a Volume and point this at its mount
# path (e.g. /data) — the container filesystem is wiped on every deploy.
DATA_DIR=
